APP_NAME=MarinaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Só preencher atrás de um proxy que encerra o TLS. Na Vercel use `*`: o tráfego
# chega exclusivamente pela borda deles, então não há cabeçalho forjável.
TRUSTED_PROXIES=

# Sail: non-default ports so this can run alongside workout-360 (80 / 5173)
APP_PORT=8080
VITE_PORT=5174

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Em ambiente serverless use `stderr`: a plataforma coleta a saída de erro, e o
# filesystem da função é somente-leitura fora de /tmp.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Produção (Neon). A aplicação fala com o host agrupado — sufixo `-pooler` —
# porque cada invocação da função abre uma conexão nova. O host direto fica em
# DB_HOST_UNPOOLED e atende a conexão `pgsql-unpooled`, usada pelas migrações:
# o PgBouncer em transaction mode não aceita SET, tabela temporária nem PREPARE.
# Mais simples do que separar em campos: cole a string que o Neon entrega. O
# parser do Laravel reconhece o esquema `postgresql` e transforma os parâmetros
# da query (`sslmode`) em configuração. DB_HOST fica de fora — a URI inteira ali
# faz o Laravel tentar resolvê-la como nome de host.
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USUARIO:SENHA@ep-exemplo-123456-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
# DB_URL_UNPOOLED=postgresql://USUARIO:SENHA@ep-exemplo-123456.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
#
# Em campos separados, se preferir:
# DB_HOST=ep-exemplo-123456-pooler.c-2.sa-east-1.aws.neon.tech
# DB_HOST_UNPOOLED=ep-exemplo-123456.c-2.sa-east-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=
# DB_SSLMODE=require
#
# Na Vercel, use os campos separados em vez de DB_URL e acrescente:
# DB_NEON_ENDPOINT=ep-exemplo-123456
# O libpq do runtime serverless não envia SNI, e sem ele o Neon não sabe a qual
# endpoint rotear. A variável prefixa a senha com `endpoint=<id>;`, que é o
# contorno documentado. O identificador vai *sem* o sufixo `-pooler`, mesmo
# quando o host tem. Com DB_URL a senha vem da própria URI e o prefixo é perdido.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responda@marinaflow.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
